[5.297, "o", "***База данных***\r\n"]
[5.297, "o", "\r\n***Процесс работы с таблицей***\r\n"]
[5.297, "o", "Функции:\r\n"]
[5.297, "o", "<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> exit - выход из программы\r\n"]
[5.297, "o", "<command> help - справочная информация\r\nТипы столбцов: int, str, bool. Столбец ID:int добавляется автоматически.\r\n"]
[5.297, "o", "\r\n>>>Введите команду: "]
[6.11, "o", "\u001b[22;21Hcreate_table users name:str age:int is_active:bool\u001b[22;71H"]
[6.11, "o", "\u001b[22;71H\r\n"]
[6.11, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[6.11, "o", "\r\n>>>Введите команду: "]
[6.922, "o", "\u001b[25;21Hlist_tables\u001b[25;32H"]
[6.922, "o", "\u001b[25;32H\r\n"]
[6.922, "o", "- users\r\n"]
[6.922, "o", "\r\n>>>Введите команду: "]
[7.719, "o", "\u001b[28;21Hcreate_table users name:str\u001b[28;48H"]
[7.719, "o", "\u001b[28;48H\r\n"]
[7.719, "o", "Ошибка: Таблица \"users\" уже существует.\r\n"]
[7.719, "o", "\r\n>>>Введите команду: "]
[8.532, "o", "\u001b[30;21Hdrop_table users\u001b[30;37H"]
[8.532, "o", "\u001b[30;37H\r\n"]
[8.532, "o", "Таблица \"users\" успешно удалена.\r\n"]
[8.532, "o", "\r\n>>>Введите команду: "]
[9.329, "o", "\u001b[30;21Hlist_tables\u001b[30;32H"]
[9.329, "o", "\u001b[30;32H\r\n"]
[9.329, "o", "Таблиц пока нет.\r\n"]
[9.329, "o", "\r\n>>>Введите команду: "]
[10.141, "o", "\u001b[30;21Hdrop_table products\u001b[30;40H"]
[10.141, "o", "\u001b[30;40H\r\n"]
[10.141, "o", "Ошибка: Таблица \"products\" не существует.\r\n"]
[10.141, "o", "\r\n>>>Введите команду: "]
[10.938, "o", "\u001b[30;21Hexit\u001b[30;25H"]
[10.938, "o", "\u001b[30;25H\r\n"]
