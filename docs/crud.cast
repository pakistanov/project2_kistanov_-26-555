[5.719, "o", "***База данных***\r\n"]
[5.719, "o", "\r\n***Управление таблицами***\r\ncreate_table <имя> <столбец:тип> ... - создать таблицу\r\nlist_tables - показать список таблиц\r\ndrop_table <имя> - удалить таблицу\r\n\r\n***Операции с данными***\r\n"]
[5.735, "o", "insert into <имя> values (<значение1>, ...) - добавить запись\r\nselect from <имя> [where <столбец> = <значение>] - прочитать записи\r\nupdate <имя> set <столбец> = <значение> where <столбец> = <значение>\r\ndelete from <имя> where <столбец> = <значение> - удалить записи\r\n"]
[5.735, "o", "info <имя> - информация о таблице\r\nhelp - справка; exit - выход\r\nТипы: int, str, bool. Строки — в кавычках. ID создаётся автоматически.\r\n"]
[5.735, "o", "\r\n>>>Введите команду: "]
[6.735, "o", "\u001b[29;21Hcreate_table users name:str age:int is_active:bool\u001b[29;71H"]
[6.735, "o", "\u001b[29;71H\r\n"]
[6.735, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[6.735, "o", "\r\n>>>Введите команду: "]
[7.735, "o", "\u001b[30;21Hinsert into users values (\"Sergei\", 28, true)\u001b[30;66H"]
[7.735, "o", "\u001b[30;66H\r\n"]
[7.735, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[7.75, "o", "\r\n>>>Введите команду: "]
[8.75, "o", "\u001b[30;21Hinsert into users values (\"Anna\", 24, false)\u001b[30;65H"]
[8.75, "o", "\u001b[30;65H\r\n"]
[8.75, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[8.75, "o", "\r\n>>>Введите команду: "]
[9.75, "o", "\u001b[30;21Hselect from users\u001b[30;38H"]
[9.75, "o", "\u001b[30;38H\r\n"]
[9.797, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n| 2  |  Anna  |  24 |   False   |\r\n+----+--------+-----+-----------+"]
[9.797, "o", "\r\n"]
[9.797, "o", "\r\n>>>Введите команду: "]
[10.797, "o", "\u001b[30;21Hselect from users where age = 28\u001b[30;53H"]
[10.797, "o", "\u001b[30;53H\r\n"]
[10.813, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+"]
[10.813, "o", "\r\n"]
[10.813, "o", "\r\n>>>Введите команду: "]
[11.813, "o", "\u001b[30;21Hupdate users set age = 29 where name = \"Sergei\"\u001b[30;68H"]
[11.813, "o", "\u001b[30;68H\r\n"]
[11.813, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[11.813, "o", "\r\n>>>Введите команду: "]
[12.813, "o", "\u001b[30;21Hselect from users where ID = 1\u001b[30;51H"]
[12.813, "o", "\u001b[30;51H\r\n"]
[12.828, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+"]
[12.828, "o", "\r\n"]
[12.828, "o", "\r\n>>>Введите команду: "]
[13.828, "o", "\u001b[30;21Hdelete from users where ID = 1\u001b[30;51H"]
[13.828, "o", "\u001b[30;51H\r\n"]
[13.828, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n"]
[13.828, "o", "\r\n>>>Введите команду: "]
[14.828, "o", "\u001b[30;21Hselect from users\u001b[30;38H"]
[14.828, "o", "\u001b[30;38H\r\n"]
[14.844, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n| 2  | Anna |  24 |   False   |\r\n+----+------+-----+-----------+"]
[14.844, "o", "\r\n"]
[14.844, "o", "\r\n>>>Введите команду: "]
[15.844, "o", "\u001b[30;21Hinfo users\u001b[30;31H"]
[15.844, "o", "\u001b[30;31H\r\n"]
[15.844, "o", "Таблица: users\r\n"]
[15.844, "o", "Столбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 1\r\n"]
[15.844, "o", "\r\n>>>Введите команду: "]
[16.844, "o", "\u001b[30;21Hexit\u001b[30;25H"]
[16.844, "o", "\u001b[30;25H\r\n"]
