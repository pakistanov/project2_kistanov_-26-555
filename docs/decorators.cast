[5.687, "o", "***База данных***\r\n"]
[5.687, "o", "\r\n***Управление таблицами***\r\ncreate_table <имя> <столбец:тип> ... - создать таблицу\r\n"]
[5.687, "o", "list_tables - показать список таблиц\r\ndrop_table <имя> - удалить таблицу\r\n\r\n***Операции с данными***\r\ninsert into <имя> values (<значение1>, ...) - добавить запись\r\n"]
[5.687, "o", "select from <имя> [where <столбец> = <значение>] - прочитать записи\r\nupdate <имя> set <столбец> = <значение> where <столбец> = <значение>\r\ndelete from <имя> where <столбец> = <значение> - удалить записи\r\ninfo <имя> - информация о таблице\r\n"]
[5.687, "o", "help - справка; exit - выход\r\nТипы: int, str, bool. Строки — в кавычках. ID создаётся автоматически.\r\nУдаление требует подтверждения y; любой другой ответ отменяет действие.\r\n"]
[5.703, "o", "\r\n>>>Введите команду: "]
[6.703, "o", "\u001b[30;21Hcreate_table users name:str age:int is_active:bool\u001b[30;71H"]
[6.703, "o", "\u001b[30;71H\r\n"]
[6.703, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[6.703, "o", "\r\n>>>Введите команду: "]
[7.703, "o", "\u001b[30;21Hlist_tables\u001b[30;32H"]
[7.703, "o", "\u001b[30;32H\r\n"]
[7.703, "o", "- users\r\n"]
[7.703, "o", "\r\n>>>Введите команду: "]
[8.703, "o", "\u001b[30;21Hinsert into users values (\"Sergei\", 28, true)\u001b[30;66H"]
[8.703, "o", "\u001b[30;66H\r\n"]
[8.719, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[8.719, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[8.719, "o", "\r\n>>>Введите команду: "]
[9.719, "o", "\u001b[30;21Hselect from users\u001b[30;38H"]
[9.719, "o", "\u001b[30;38H\r\n"]
[9.719, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[9.75, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+"]
[9.75, "o", "\r\n"]
[9.75, "o", "\r\n>>>Введите команду: "]
[10.75, "o", "\u001b[30;21Hselect from users where age = 28\u001b[30;53H"]
[10.75, "o", "\u001b[30;53H\r\n"]
[10.75, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[10.75, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+"]
[10.75, "o", "\r\n"]
[10.75, "o", "\r\n>>>Введите команду: "]
[11.75, "o", "\u001b[30;21Hselect from users where age = 28\u001b[30;53H"]
[11.765, "o", "\u001b[30;53H\r\n"]
[11.765, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[11.765, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+"]
[11.765, "o", "\r\n"]
[11.765, "o", "\r\n>>>Введите команду: "]
[12.765, "o", "\u001b[30;21Hinsert into users values (\"Wrong\", \"28\", true)\u001b[30;67H"]
[12.765, "o", "\u001b[30;67H\r\n"]
[12.765, "o", "Ошибка валидации: Столбец \"age\" требует тип int, получено значение '28'.\r\n"]
[12.765, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[12.765, "o", "\r\n>>>Введите команду: "]
[13.765, "o", "\u001b[30;21Hselect from users where unknown = 1\u001b[30;56H"]
[13.781, "o", "\u001b[30;56H\r\n"]
[13.781, "o", "Ошибка: Таблица или столбец 'unknown' не найден.\r\n"]
[13.781, "o", "\r\n>>>Введите команду: "]
[14.781, "o", "\u001b[30;21Hupdate users set age = 29 where name = \"Sergei\"\u001b[30;68H"]
[14.781, "o", "\u001b[30;68H\r\n"]
[14.781, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[14.781, "o", "\r\n>>>Введите команду: "]
[15.781, "o", "\u001b[30;21Hselect from users where age = 28\u001b[30;53H"]
[15.781, "o", "\u001b[30;53H\r\n"]
[15.781, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[15.781, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n+----+------+-----+-----------+"]
[15.797, "o", "\r\n"]
[15.797, "o", "\r\n>>>Введите команду: "]
[16.797, "o", "\u001b[30;21Hselect from users where age = 29\u001b[30;53H"]
[16.797, "o", "\u001b[30;53H\r\n"]
[16.797, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[16.797, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+"]
[16.797, "o", "\r\n"]
[16.797, "o", "\r\n>>>Введите команду: "]
[17.797, "o", "\u001b[30;21Hdelete from users where ID = 1\u001b[30;51H"]
[17.797, "o", "\u001b[30;51H\r\n"]
[17.797, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[18.812, "o", "\u001b[30;61Hn\u001b[30;62H"]
[18.812, "o", "\u001b[30;62H\r\nОперация отменена.\r\n"]
[18.812, "o", "\r\n>>>Введите команду: "]
[19.812, "o", "\u001b[30;21Hselect from users\u001b[30;38H"]
[19.812, "o", "\u001b[30;38H\r\n"]
[19.812, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[19.812, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+"]
[19.812, "o", "\r\n"]
[19.812, "o", "\r\n>>>Введите команду: "]
[20.812, "o", "\u001b[30;21Hdelete from users where ID = 1\u001b[30;51H"]
[20.812, "o", "\u001b[30;51H\r\n"]
[20.812, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[21.812, "o", "\u001b[30;61Hy\u001b[30;62H"]
[21.828, "o", "\u001b[30;62H\r\n"]
[21.828, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n"]
[21.828, "o", "\r\n>>>Введите команду: "]
[22.828, "o", "\u001b[30;21Hinfo users\u001b[30;31H"]
[22.828, "o", "\u001b[30;31H\r\n"]
[22.828, "o", "Таблица: users\r\n"]
[22.828, "o", "Столбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 0\r\n"]
[22.828, "o", "\r\n>>>Введите команду: "]
[23.828, "o", "\u001b[30;21Hdrop_table users\u001b[30;37H"]
[23.828, "o", "\u001b[30;37H\r\n"]
[23.828, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[24.828, "o", "\u001b[30;61Hn\u001b[30;62H"]
[24.844, "o", "\u001b[30;62H\r\nОперация отменена.\r\n"]
[24.844, "o", "\r\n>>>Введите команду: "]
[25.844, "o", "\u001b[30;21Hlist_tables\u001b[30;32H"]
[25.844, "o", "\u001b[30;32H\r\n"]
[25.844, "o", "- users\r\n"]
[25.844, "o", "\r\n>>>Введите команду: "]
[26.844, "o", "\u001b[30;21Hdrop_table users\u001b[30;37H"]
[26.844, "o", "\u001b[30;37H\r\n"]
[26.844, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
