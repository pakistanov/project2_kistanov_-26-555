[6.078, "o", "***База данных***\r\n"]
[6.078, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> ... - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\nФункции:\r\n<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи по условию\r\n<command> select from <имя_таблицы> - прочитать все записи\r\n<command> update <имя_таблицы> set <столбец> = <новое_значение> where <столбец> = <значение> - обновить запись\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить запись\r\n<command> info <имя_таблицы> - вывести информацию о таблице\r\n<command> help - справочная информация\r\n<command> exit - выход из программы\r\n"]
[6.078, "o", "\r\n>>>Введите команду: "]
[7.078, "o", "\u001b[30;21Hcreate_table users name:str age:int is_active:bool\u001b[30;71H"]
[7.078, "o", "\u001b[30;71H\r\n"]
[7.078, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[7.078, "o", "\r\n>>>Введите команду: "]
[8.078, "o", "\u001b[30;21Hlist_tables\u001b[30;32H"]
[8.078, "o", "\u001b[30;32H\r\n"]
[8.078, "o", "- users\r\n"]
[8.094, "o", "\r\n>>>Введите команду: "]
[9.094, "o", "\u001b[30;21Hinsert into users values (\"  Ivanov, Ivan  \",28,TRUE)\u001b[30;74H"]
[9.094, "o", "\u001b[30;74H\r\n"]
[9.094, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[9.094, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[9.094, "o", "\r\n>>>Введите команду: "]
[10.094, "o", "\u001b[30;21Hinsert into users values ( \"Sergei\" , 29 , true )\u001b[30;70H"]
[10.094, "o", "\u001b[30;70H\r\n"]
[10.094, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[10.094, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[10.094, "o", "\r\n>>>Введите команду: "]
[11.094, "o", "\u001b[30;21Hselect from users\u001b[30;38H"]
[11.109, "o", "\u001b[30;38H\r\n"]
[11.109, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[11.422, "o", "+----+------------------+-----+-----------+\r\n| ID |       name       | age | is_active |\r\n+----+------------------+-----+-----------+\r\n| 1  |   Ivanov, Ivan   |  28 |    True   |\r\n| 2  |      Sergei      |  29 |    True   |\r\n+----+------------------+-----+-----------+"]
[11.422, "o", "\r\n"]
[11.422, "o", "\r\n>>>Введите команду: "]
[12.422, "o", "\u001b[30;21Hselect from users\u001b[30;38H"]
[12.422, "o", "\u001b[30;38H\r\n"]
[12.422, "o", "+----+------------------+-----+-----------+\r\n| ID |       name       | age | is_active |\r\n+----+------------------+-----+-----------+\r\n| 1  |   Ivanov, Ivan   |  28 |    True   |\r\n| 2  |      Sergei      |  29 |    True   |\r\n+----+------------------+-----+-----------+"]
[12.437, "o", "\r\n"]
[12.437, "o", "\r\n>>>Введите команду: "]
[13.437, "o", "\u001b[30;21Hupdate users set age = 30 where name = \"Sergei\"\u001b[30;68H"]
[13.437, "o", "\u001b[30;68H\r\n"]
[13.437, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[13.437, "o", "Запись с ID=2 в таблице \"users\" успешно обновлена.\r\n"]
[13.437, "o", "\r\n>>>Введите команду: "]
[14.437, "o", "\u001b[30;21Hselect from users where name = \"Sergei\"\u001b[30;60H"]
[14.437, "o", "\u001b[30;60H\r\n"]
[14.437, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[14.437, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 2  | Sergei |  30 |    True   |\r\n+----+--------+-----+-----------+"]
[14.453, "o", "\r\n"]
[14.453, "o", "\r\n>>>Введите команду: "]
[15.453, "o", "\u001b[30;21Hupdate users set ID = 10 where ID = 1\u001b[30;58H"]
[15.453, "o", "\u001b[30;58H\r\n"]
[15.453, "o", "Ошибка: Изменение столбца ID запрещено.\r\n"]
[15.453, "o", "\r\n>>>Введите команду: "]
[16.453, "o", "\u001b[30;21Hdelete from users where ID = 999\u001b[30;53H"]
[16.453, "o", "\u001b[30;53H\r\n"]
[16.453, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[16.453, "o", "Записи по условию не найдены.\r\n"]
[16.453, "o", "\r\n>>>Введите команду: "]
[17.453, "o", "\u001b[30;21Hdelete from users where ID = 1\u001b[30;51H"]
[17.469, "o", "\u001b[30;51H\r\n"]
[17.469, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[17.469, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[18.469, "o", "\u001b[30;61Hn\u001b[30;62H"]
[18.469, "o", "\u001b[30;62H\r\n"]
[18.469, "o", "Операция отменена.\r\n"]
[18.469, "o", "\r\n>>>Введите команду: "]
[19.469, "o", "\u001b[30;21Hdelete from users where ID = 1\u001b[30;51H"]
[19.469, "o", "\u001b[30;51H\r\n"]
[19.469, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[20.469, "o", "\u001b[30;61Hy\u001b[30;62H"]
[20.484, "o", "\u001b[30;62H\r\n"]
[20.484, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n"]
[20.484, "o", "\r\n>>>Введите команду: "]
[21.484, "o", "\u001b[30;21Hselect from users\u001b[30;38H"]
[21.484, "o", "\u001b[30;38H\r\n"]
[21.484, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[21.484, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 2  | Sergei |  30 |    True   |\r\n+----+--------+-----+-----------+"]
[21.484, "o", "\r\n"]
[21.484, "o", "\r\n>>>Введите команду: "]
[22.484, "o", "\u001b[30;21Hinfo users\u001b[30;31H"]
[22.484, "o", "\u001b[30;31H\r\n"]
[22.5, "o", "Таблица: users\r\n"]
[22.5, "o", "Столбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 1\r\n"]
[22.5, "o", "\r\n>>>Введите команду: "]
[23.5, "o", "\u001b[30;21Hdrop_table products\u001b[30;40H"]
[23.5, "o", "\u001b[30;40H\r\n"]
[23.5, "o", "Ошибка: Таблица \"products\" не существует.\r\n"]
[23.5, "o", "\r\n>>>Введите команду: "]
[24.5, "o", "\u001b[30;21Hcreate_table Users id:str\u001b[30;46H"]
[24.5, "o", "\u001b[30;46H\r\n"]
[24.5, "o", "Таблица \"Users\" успешно создана со столбцами: ID:int, id:str\r\n"]
[24.5, "o", "\r\n>>>Введите команду: "]
[25.516, "o", "\u001b[30;21Hinsert into Users values (\"Separate table\")\u001b[30;64H"]
[25.516, "o", "\u001b[30;64H\r\n"]
[25.516, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[25.516, "o", "Запись с ID=1 успешно добавлена в таблицу \"Users\".\r\n"]
[25.516, "o", "\r\n>>>Введите команду: "]
[26.516, "o", "\u001b[30;21Hselect from Users\u001b[30;38H"]
[26.516, "o", "\u001b[30;38H\r\n"]
[26.516, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[26.516, "o", "+----+----------------+\r\n| ID |       id       |\r\n+----+----------------+\r\n| 1  | Separate table |\r\n+----+----------------+"]
[26.516, "o", "\r\n"]
[26.516, "o", "\r\n>>>Введите команду: "]
[27.516, "o", "\u001b[30;21Hselect from users\u001b[30;38H"]
[27.531, "o", "\u001b[30;38H\r\n"]
[27.531, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[27.531, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 2  | Sergei |  30 |    True   |\r\n+----+--------+-----+-----------+"]
[27.531, "o", "\r\n"]
[27.531, "o", "\r\n>>>Введите команду: "]
