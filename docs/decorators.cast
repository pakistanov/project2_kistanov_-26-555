[5.86, "o", "\u001b[11;5H\u001b[93mdatabase\r\n\u001b[37m>> \u001b[39;49m\u001b[0m\u001b[11;13H\u001b[?25h"]
[5.86, "o", "\u001b[?25l\u001b[13;1H\u001b[39;49m\u001b[0m\u001b[12;4H\u001b[?25h"]
