[5.86, "o", "\u001b[0m"]
[5.86, "o", "\u001b[0m"]
[5.953, "o", "***База данных***\r\n"]
[5.953, "o", "\r\n***Управление таблицами***\r\ncreate_table <имя> <столбец:тип> ... - создать таблицу\r\nlist_tables - показать список таблиц\r\n"]
[5.953, "o", "drop_table <имя> - удалить таблицу\r\n\r\n***Операции с данными***\r\n"]
[5.953, "o", "insert into <имя> values (<значение1>, ...) - добавить запись\r\nselect from <имя> [where <столбец> = <значение>] - прочитать записи\r\nupdate <имя> set <столбец> = <значение> where <столбец> = <значение>\r\ndelete from <имя> where <столбец> = <значение> - удалить записи\r\n"]
[5.953, "o", "info <имя> - информация о таблице\r\nhelp - справка; exit - выход\r\nТипы: int, str, bool. Строки — в кавычках. ID создаётся автоматически.\r\nУдаление требует подтверждения y; любой другой ответ отменяет действие.\r\n"]
[5.969, "o", "\r\n>>>Введите команду: "]
[6.969, "o", "\u001b[30;21Hcreate_table users name:str age:int is_active:bool\u001b[30;71H"]
[6.969, "o", "\u001b[30;71H\r\n"]
[6.969, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[6.969, "o", "\r\n>>>Введите команду: "]
[7.969, "o", "\u001b[30;21Hinsert into users values (\"Sergei\", 28, true)\u001b[30;66H"]
[7.969, "o", "\u001b[30;66H\r\n"]
[7.969, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[7.969, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[7.969, "o", "\r\n>>>Введите команду: "]
[8.969, "o", "\u001b[30;21Hselect from users where age = 28\u001b[30;53H"]
[8.969, "o", "\u001b[30;53H\r\n"]
[8.985, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[9.0, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+"]
[9.016, "o", "\r\n"]
[9.016, "o", "\r\n>>>Введите команду: "]
[10.016, "o", "\u001b[30;21Hselect from users where age = 28\u001b[30;53H"]
[10.016, "o", "\u001b[30;53H\r\n"]
[10.016, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[10.016, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+"]
[10.016, "o", "\r\n"]
[10.016, "o", "\r\n>>>Введите команду: "]
[11.016, "o", "\u001b[30;21Hinsert into users values (\"Wrong\", \"28\", true)\u001b[30;67H"]
[11.016, "o", "\u001b[30;67H\r\n"]
[11.016, "o", "Ошибка валидации: Столбец \"age\" требует тип int, получено значение '28'.\r\n"]
[11.031, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[11.031, "o", "\r\n>>>Введите команду: "]
[12.031, "o", "\u001b[30;21Hselect from users where unknown = 1\u001b[30;56H"]
[12.031, "o", "\u001b[30;56H\r\n"]
[12.031, "o", "Ошибка: Таблица или столбец 'unknown' не найден.\r\n"]
[12.031, "o", "\r\n>>>Введите команду: "]
[13.031, "o", "\u001b[30;21Hupdate users set age = 29 where name = \"Sergei\"\u001b[30;68H"]
[13.031, "o", "\u001b[30;68H\r\n"]
[13.031, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[13.031, "o", "\r\n>>>Введите команду: "]
[14.031, "o", "\u001b[30;21Hselect from users where age = 28\u001b[30;53H"]
[14.031, "o", "\u001b[30;53H\r\n"]
[14.047, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[14.047, "o", "+----+------+-----+-----------+\r\n| ID | name | age | is_active |\r\n+----+------+-----+-----------+\r\n+----+------+-----+-----------+"]
[14.047, "o", "\r\n"]
[14.047, "o", "\r\n>>>Введите команду: "]
[15.047, "o", "\u001b[30;21Hselect from users where age = 29\u001b[30;53H"]
[15.047, "o", "\u001b[30;53H\r\n"]
[15.047, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[15.047, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+"]
[15.047, "o", "\r\n"]
[15.047, "o", "\r\n>>>Введите команду: "]
[16.047, "o", "\u001b[30;21Hdelete from users where ID = 1\u001b[30;51H"]
[16.063, "o", "\u001b[30;51H\r\n"]
[16.063, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[17.063, "o", "\u001b[30;61Hn\u001b[30;62H"]
[17.063, "o", "\u001b[30;62H\r\nОперация отменена.\r\n"]
[17.063, "o", "\r\n>>>Введите команду: "]
[18.063, "o", "\u001b[30;21Hselect from users\u001b[30;38H"]
[18.063, "o", "\u001b[30;38H\r\n"]
[18.063, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[18.063, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[18.063, "o", "\r\n>>>Введите команду: "]
[19.063, "o", "\u001b[30;21Hdelete from users where ID = 1\u001b[30;51H"]
[19.078, "o", "\u001b[30;51H\r\n"]
[19.078, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[20.078, "o", "\u001b[30;61Hy\u001b[30;62H"]
[20.078, "o", "\u001b[30;62H\r\n"]
[20.078, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n"]
[20.078, "o", "\r\n>>>Введите команду: "]
[21.078, "o", "\u001b[30;21Hinfo users\u001b[30;31H"]
[21.078, "o", "\u001b[30;31H\r\n"]
[21.078, "o", "Таблица: users\r\n"]
[21.078, "o", "Столбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 0\r\n"]
[21.078, "o", "\r\n>>>Введите команду: "]
[22.078, "o", "\u001b[30;21Hdrop_table users\u001b[30;37H"]
[22.094, "o", "\u001b[30;37H\r\n"]
[22.094, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[23.094, "o", "\u001b[30;61Hn\u001b[30;62H"]
[23.094, "o", "\u001b[30;62H\r\n"]
[23.094, "o", "Операция отменена.\r\n"]
[23.094, "o", "\r\n>>>Введите команду: "]
[24.094, "o", "\u001b[30;21Hlist_tables\u001b[30;32H"]
[24.094, "o", "\u001b[30;32H\r\n"]
[24.094, "o", "- users\r\n"]
[24.094, "o", "\r\n>>>Введите команду: "]
[25.094, "o", "\u001b[30;21Hdrop_table users\u001b[30;37H"]
[25.094, "o", "\u001b[30;37H\r\n"]
[25.11, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[26.11, "o", "\u001b[30;61Hy\u001b[30;62H"]
[26.11, "o", "\u001b[30;62H\r\n"]
[26.11, "o", "Таблица \"users\" успешно удалена.\r\n"]
[26.11, "o", "\r\n>>>Введите команду: "]
[27.11, "o", "\u001b[30;21Hlist_tables\u001b[30;32H"]
[27.11, "o", "\u001b[30;32H\r\n"]
[27.11, "o", "Таблиц пока нет.\r\n"]
[27.11, "o", "\r\n>>>Введите команду: "]
[28.11, "o", "\u001b[30;21Hexit\u001b[30;25H"]
[28.11, "o", "\u001b[30;25H\r\n"]
